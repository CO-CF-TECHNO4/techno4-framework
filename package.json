{
  "name": "techno4",
  "version": "2.0.1",
  "description": "Techno4 Framework Core - reactive UI components, VDOM, router and unified theme with Apache Cordova support",
  "keywords": [
    "techno4",
    "framework",
    "cordova",
    "apache-cordova",
    "mobile",
    "ios",
    "android",
    "reactive",
    "vdom",
    "ui",
    "pwa"
  ],
  "license": "LGPL-3.0-or-later",
  "author": "Mykola Zghurskyi <mykola@techno4.online>",
  "homepage": "https://techno4.online",
  "repository": {
    "type": "git",
    "url": "git@github.com:CO-CF-TECHNO4/techno4-framework.git"
  },
  "bugs": {
    "url": "https://github.com/CO-CF-TECHNO4/techno4-framework/issues"
  },
  "type": "module",
  "main": "dist/techno4.bundle.js",
  "module": "dist/techno4.esm.js",
  "types": "src/techno4.d.ts",
  "exports": {
    ".": {
      "import": "./dist/techno4.esm.js",
      "require": "./dist/techno4.bundle.js",
      "types": "./src/techno4.d.ts"
    },
    "./bundle": {
      "import": "./dist/techno4.esm.js",
      "require": "./dist/techno4.bundle.js",
      "types": "./src/techno4.d.ts"
    },
    "./css": "./dist/techno4.bundle.css",
    "./css/bundle": "./dist/techno4.bundle.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-core.js"
  },
  "dependencies": {
    "dom64": "^0.1.1",
    "htm": "^3.1.1",
    "path-to-regexp": "^6.3.0",
    "skeleton-elements": "^4.0.1",
    "ssr-window": "^5.0.1",
    "swiper": "^12.1.2"
  }
}
